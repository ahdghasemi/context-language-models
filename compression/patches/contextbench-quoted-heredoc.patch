+
+@pytest.mark.parametrize("command", [
+    "printf '<<<ANSWER key=K00000>>>\n%s\n<<<ANSWER END>>>\n' value; echo READY_FOR_NEXT_OP",
+    'printf "<<<ANSWER key=K00000>>>\n%s\n<<<ANSWER END>>>\n" value; echo READY_FOR_NEXT_OP',
+    "printf '%s\n' '<<EOF\ntext\n'; echo READY_FOR_NEXT_OP",
+    "printf '%s' '\n<<EOF\ntext\n'; echo READY_FOR_NEXT_OP",
+    "cat <<<value\necho READY_FOR_NEXT_OP",
+    "cat <<<\"value\"\necho READY_FOR_NEXT_OP",
+    "printf '%s' \\<<EOF\necho READY_FOR_NEXT_OP",
+    "# cat <<EOF\necho READY_FOR_NEXT_OP",
+    "printf '%s' 'x' # <<EOF\necho READY_FOR_NEXT_OP",
+    "printf '%s' 'multiline\ntext'; cat <<'EOF'\nbody\nEOF\necho READY_FOR_NEXT_OP",
+])
+def test_quoted_delimiters_and_here_strings_do_not_swallow_real_marker(command):
+    assert proto.is_ready_command(command)
+    assert not proto.is_ready_command(command, exit_code=1)
+
+
+@pytest.mark.parametrize("command", [
+    "printf '<<<ANSWER key=K00000>>>\necho READY_FOR_NEXT_OP\n<<<ANSWER END>>>\n'",
+    "printf '%s' 'unterminated\n<<<ANSWER\necho READY_FOR_NEXT_OP",
+    "cat <<EOF\necho READY_FOR_NEXT_OP\nEOF",
+    "cat <<'EOF'\necho READY_FOR_NEXT_OP\nEOF",
+    "cat <<\"EOF\"\necho READY_FOR_NEXT_OP\nEOF",
+    "cat <<-EOF\n\techo READY_FOR_NEXT_OP\n\tEOF",
+    "cat <<A <<'B'\nfirst\nA\necho READY_FOR_NEXT_OP\nB",
+    "cat <<<\"value\necho READY_FOR_NEXT_OP\"",
+    "printf '%s' 'before\ntext'; cat <<'EOF'\necho READY_FOR_NEXT_OP\nEOF",
+])
+def test_marker_inside_data_still_does_not_advance(command):
+    assert not proto.is_ready_command(command)
+
+
+def test_multiline_answer_data_does_not_swallow_real_submit():
+    assert proto.is_submit_command(
+        "printf '<<<ANSWER>>>\nvalue\n<<<ANSWER END>>>\n'; echo COMPLETE_TASK_AND_SUBMIT_FINAL_OUTPUT")
+    assert not proto.is_submit_command(
+        "printf '<<<ANSWER>>>\necho COMPLETE_TASK_AND_SUBMIT_FINAL_OUTPUT\n<<<ANSWER END>>>\n'")
+
+
+@pytest.mark.xfail(strict=True, reason="existing statement splitter does not parse nested shell substitutions")
+def test_nested_substitution_remains_an_explicit_parser_limitation():
+    command = '''printf '%s\n' "$(printf '%s' '=\"[^\"]*\"')"; echo READY_FOR_NEXT_OP'''
+    assert proto.is_ready_command(command)
