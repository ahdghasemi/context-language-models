+# Modified by tiny-clm: quote-aware here-document detection. The existing
+# readiness/submit contracts and statement matcher remain unchanged.
@@ -88,0 +92,39 @@
+def _heredoc_openings(line: str, quote: str | None) -> tuple[list[tuple[str, str, str]], str | None]:
+    """Find real here-doc operators, carrying shell quote state between lines.
+
+    Quoted text (including multiline printf formats) and here-strings are not
+    here-doc openers. Keep the existing identifier-delimiter grammar; this is
+    not a general shell parser or proof that every matched statement executes.
+    """
+    pending: list[tuple[str, str, str]] = []
+    i = 0
+    while i < len(line):
+        c = line[i]
+        if quote is not None:
+            if quote == '"' and c == "\\":
+                i += 2
+                continue
+            if c == quote:
+                quote = None
+            i += 1
+            continue
+        if c == "\\":
+            i += 2
+            continue
+        if c in "'\"":
+            quote = c
+        elif c == "#" and (i == 0 or line[i - 1].isspace() or line[i - 1] in ";|&()"):
+            break
+        elif line.startswith("<<<", i):
+            i += 3
+            continue
+        elif line.startswith("<<", i):
+            match = _HEREDOC_OPEN.match(line, i)
+            if match:
+                pending.append(match.groups())
+                i = match.end()
+                continue
+        i += 1
+    return pending, quote
+
+
