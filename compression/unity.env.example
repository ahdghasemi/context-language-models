# Copy outside the immutable run snapshots; source this file in your login shell.
export TINY_CLM_PARENT=/work/pi_aghasemi_umass_edu
export TINY_CLM_ROOT="$TINY_CLM_PARENT/context-language-models"
export TINY_CLM_WORK="$TINY_CLM_PARENT/tiny_clm_work"
export TINY_CLM_VENV="$TINY_CLM_WORK/env"
export TINY_CLM_ASSETS="$TINY_CLM_WORK/assets/qwen3-06-wikitext"
export TINY_CLM_RUNS="$TINY_CLM_WORK/campaigns"
export TINY_CLM_SNAPSHOTS="$TINY_CLM_WORK/snapshots"
export HF_HOME="$TINY_CLM_WORK/cache/huggingface"
export HF_DATASETS_CACHE="$TINY_CLM_WORK/cache/datasets"
export PIP_CACHE_DIR="$TINY_CLM_WORK/cache/pip"
export APPTAINER_CACHEDIR="$TINY_CLM_WORK/cache/apptainer"
export SINGULARITY_CACHEDIR="$APPTAINER_CACHEDIR"
export TMPDIR="$TINY_CLM_WORK/tmp"
export TINY_CLM_PYTHON=python3.12
# Official PyTorch 2.8 CUDA wheel; verify installed NVIDIA driver compatibility.
export TINY_CLM_TORCH_INDEX=https://download.pytorch.org/whl/cu128
# Public Unity partitions verified in official docs; personal access is unverified.
export TINY_CLM_PARTITION=gpu
export TINY_CLM_CPU_PARTITION=cpu
# Set account/QoS only if required for YOUR association. No account is assumed.
export TINY_CLM_ACCOUNT=
export TINY_CLM_QOS=
# REQUIRED before GPU submission. Use a feature shown by sinfo, with >=24 GiB
# VRAM and BF16 support. We intentionally do not invent a GPU constraint.
export TINY_CLM_GPU_CONSTRAINT=
export TINY_CLM_GPUS=1
export TINY_CLM_CPUS=8
export TINY_CLM_MEM=64G
export TINY_CLM_TIME=12:00:00
export TINY_CLM_CONTEXTBENCH_TIME=24:00:00
export TINY_CLM_CONCURRENCY=2
export TINY_CLM_CONTEXTBENCH="$TINY_CLM_WORK/external/ContextBench"
# Harbor requires a working Singularity/Apptainer setup on the allocated node.
export TINY_CLM_CONTAINER=singularity
